# tools/hw/hw.env.example -- the Ж stand (real Sprinter) configuration of
# tools/hw/build_hw.sh (make hw-image) and tools/hw/echo_hw.sh.
# Copy to tools/hw/hw.env (git-ignored) and fill in the values of your
# network and board; build_hw.sh falls back to this file when hw.env is
# missing.  Plain sh assignments, no spaces around "=".

# The host (this Mac) on the Sprinter's LAN: the echo server and the
# peer of every channel.  Empty = `ipconfig getifaddr en0` at build time.
HW_HOST_IP=
# Echo server ports: plain echo (TCP + UDP) and the TCP server that closes
# after 64 bytes (scenario P).  Not 7000 / 5000: macOS AirPlay Receiver
# (ControlCenter) listens there -- with echo_hw.sh down the Sprinter would
# connect to it, and AirPlay clients of the LAN probe the echo server.
HW_PORT=7710
HW_PORT_P=7712
# The record echo of GUDPESP's transparent mode (UGTESPX, NESPX<s>;
# echo_server.py --framed)
HW_PORT_X=7714
# The game server of NETDEMO F (echo_server.py --game: a state of 88 bytes
# every 100 ms) and its record twin for NESPXF (--game --framed)
HW_PORT_G=7716
HW_PORT_GX=7718

# The Sprinter's own address (Ethernet cards only: the ESP module has its
# address from its Wi-Fi set-up), netmask and gateway.
HW_SPR_IP=192.168.1.21
HW_MASK=255.255.255.0
HW_GW=192.168.1.1

# ISA slots, 0 or 1 -- the Sprinter's own numbers (#E2 = #D4 / #D6, the
# `-s` of the old drivers, whose default is 1), never 1 or 2.  Every Ж
# program prints "SLOT c mm u": configured slot, mask of the slots that
# answer as the card (bit 0 = slot 0, bit 1 = slot 1) and the slot it
# used; a card found only in the other slot is run there, but fix the
# value here when that happens.  I/O bases of the three cards.
HW_SLOT_ESP=1
HW_SLOT_RTL=1
HW_SLOT_EL3=1
HW_IO_ESP=0x3E8
HW_IO_RTL=0x300
HW_IO_EL3=0x300
# 3C509B ID port (ISA PnP-style contention sequence)
HW_ID_PORT=0x110
# TL16C550C RX FIFO trigger of the ESP builds (1, 4, 8, 14); UGPROBE E
# measures 8, 4 and 14 whatever this says.
HW_UART_TRIGGER=8

# Local port of the channel: 0 = ephemeral (the core picks 49152+).  The
# ESP UDP build always uses HW_LOCAL_PORT_ESP_UDP (the module binds it).
HW_LOCAL_PORT=0
HW_LOCAL_PORT_ESP_UDP=7001
# NETDEMO: STEPs per 20 ms budget period
HW_STEPS=5
