# tools/hw/hw.env.example -- the Ж stand (real Sprinter) configuration of
# tools/hw/build_hw.sh (make hw-image) and tools/hw/echo_hw.sh.
# Copy to tools/hw/hw.env (git-ignored) and fill in the values of your
# network and board; build_hw.sh falls back to this file when hw.env is
# missing.  Plain sh assignments, no spaces around "=".

# The host (this Mac) on the Sprinter's LAN: the echo server and the
# peer of every channel.  Empty = `ipconfig getifaddr en0` at build time.
HW_HOST_IP=
# Echo server ports: plain echo (TCP + UDP) and the TCP server that closes
# after 64 bytes (scenario P).
HW_PORT=7000
HW_PORT_P=7002

# The Sprinter's own address (Ethernet cards only: the ESP module has its
# address from its Wi-Fi set-up), netmask and gateway.
HW_SPR_IP=192.168.1.21
HW_MASK=255.255.255.0
HW_GW=192.168.1.1

# ISA slots (1 or 2) and I/O bases of the three cards.
HW_SLOT_ESP=1
HW_SLOT_RTL=2
HW_SLOT_EL3=2
HW_IO_ESP=0x3E8
HW_IO_RTL=0x300
HW_IO_EL3=0x300
# 3C509B ID port (ISA PnP-style contention sequence)
HW_ID_PORT=0x110
# TL16C550C RX FIFO trigger of the ESP builds (1, 4, 8, 14); UGPROBE E
# measures 8, 4 and 14 whatever this says.
HW_UART_TRIGGER=8

# Local port of the channel: 0 = ephemeral (the core picks 49152+).  The
# ESP UDP build always uses HW_LOCAL_PORT_ESP_UDP (the module binds it).
HW_LOCAL_PORT=0
HW_LOCAL_PORT_ESP_UDP=7001
# NETDEMO: STEPs per 20 ms budget period
HW_STEPS=5
